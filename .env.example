# Copy to .env and fill in. Never commit the real .env.
# All values are also settable as plain environment variables.

ENVIRONMENT=development
DEBUG=true

# Postgres in production. A relative SQLite path is resolved against DATA_DIR.
#   DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/slicing
DATA_DIR=./data
DATABASE_URL=sqlite+pysqlite:///slicing.db

# REQUIRED IN PRODUCTION. Startup fails if this is left at the dev default.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=dev-insecure-secret-change-me
ACCESS_TOKEN_TTL_SECONDS=43200

CORS_ORIGINS=http://localhost:5173

# Point at your CuraEngine / OrcaSlicer / PrusaSlicer binary.
CURA_ENGINE_PATH=C:\Program Files\UltiMaker Cura 5.13.0\CuraEngine.exe
SLICER_TIMEOUT_SECONDS=900

# --- AI assistant ---------------------------------------------------------
# Ollama is the default and needs no API key: it is a local process.
#   1. install:  winget install Ollama.Ollama
#   2. fetch a model:  ollama pull qwen2.5:7b
#   3. serve:     ollama serve      (the Windows app already serves on 11434)
# Nothing in the platform fakes a model. If Ollama is unreachable the assistant
# returns LLM_UNAVAILABLE with a hint instead of guessing.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# qwen2.5:1.5b works but plans a nested request in ~25s on CPU. 7b is markedly
# better at reading "strong but lightweight" and costs more latency. Pick per
# machine; the model is validated for presence before every request.
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_KEEP_ALIVE=15m
LLM_TIMEOUT_SECONDS=180
LLM_NUM_PREDICT=512
LLM_TEMPERATURE=0.0
LLM_MAX_RETRIES=1

# Retrieval over the platform's own printing rules.
RAG_ENABLED=true
RAG_MAX_DOCUMENTS=6

# Model-directed tool calling is off by default: a 1.5B model picks the wrong
# tool often enough that the planner assembles tool context server-side instead.
LLM_TOOL_CALLING_ENABLED=false

# Optional hosted provider. Only read when LLM_PROVIDER=openai. Leave empty: the
# platform ships no key, and Ollama needs none.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Worker (run as a separate process: python -m app.workers.geometry)
JOB_WORKER_ENABLED=false
JOB_WORKER_ID=worker-local
