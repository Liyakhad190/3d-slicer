# Copy to .env and fill in. Never commit the real .env.
# All values are also settable as plain environment variables.

ENVIRONMENT=development
DEBUG=true

# Postgres in production. A relative SQLite path is resolved against DATA_DIR.
#   DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/slicing
DATA_DIR=./data
DATABASE_URL=sqlite+pysqlite:///slicing.db

# REQUIRED IN PRODUCTION. Startup fails if this is left at the dev default.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=dev-insecure-secret-change-me
ACCESS_TOKEN_TTL_SECONDS=43200

CORS_ORIGINS=http://localhost:5173

# Point at your CuraEngine / OrcaSlicer / PrusaSlicer binary.
CURA_ENGINE_PATH=C:\Program Files\UltiMaker Cura 5.13.0\CuraEngine.exe
SLICER_TIMEOUT_SECONDS=900

# AI provider. Leave disabled to run fully deterministically with no LLM.
AI_PROVIDER=disabled
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=gpt-4o-mini

# Worker (run as a separate process: python -m app.workers.geometry)
JOB_WORKER_ENABLED=false
JOB_WORKER_ID=worker-local
